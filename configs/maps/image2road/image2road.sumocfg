<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="image2road.net.xml"/>
        <route-files value="image2road.rou.xml"/>
        <additional-files value="image2road.add.xml"/>
        <gui-settings-file value="image2road.view.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="300"/>
    </processing>
    <output>
        <summary-output value="outputs/image2road_summary.xml"/>
        <tripinfo-output value="outputs/image2road_tripinfo.xml"/>
    </output>
    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>
</configuration>
